<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.butu" path="/org/gnome/shell/extensions/butu/">
    <key name="color-mode" type="s">
      <choices>
        <choice value="classic"/>
        <choice value="wallpaper"/>
        <choice value="custom"/>
      </choices>
      <default>"classic"</default>
      <summary>Pill background source</summary>
    </key>
    <key name="custom-color" type="s">
      <default>"rgb(53,132,228)"</default>
      <summary>Custom pill background color</summary>
    </key>
    <key name="accent-color" type="s">
      <default>"rgb(88,235,98)"</default>
      <summary>Accent color (percentage, battery, waves)</summary>
    </key>
    <key name="wave-effect" type="s">
      <choices>
        <choice value="sine"/>
        <choice value="cosine"/>
        <choice value="analog"/>
        <choice value="digital"/>
      </choices>
      <default>"sine"</default>
      <summary>Charging wave effect</summary>
    </key>
    <key name="compact-width" type="i">
      <range min="40" max="160"/>
      <default>84</default>
      <summary>Pill width while not charging</summary>
    </key>
    <key name="expanded-width" type="i">
      <range min="140" max="420"/>
      <default>280</default>
      <summary>Pill width while charging</summary>
    </key>
    <key name="pill-height" type="i">
      <range min="18" max="44"/>
      <default>30</default>
      <summary>Pill height</summary>
    </key>
    <key name="corner-radius" type="i">
      <range min="0" max="30"/>
      <default>15</default>
      <summary>Corner radius</summary>
    </key>
    <key name="font-size" type="i">
      <range min="9" max="20"/>
      <default>12</default>
      <summary>Text size in px</summary>
    </key>
    <key name="position" type="s">
      <choices>
        <choice value="left"/>
        <choice value="center"/>
        <choice value="right"/>
      </choices>
      <default>"center"</default>
      <summary>Panel area</summary>
    </key>
    <key name="position-index" type="i">
      <range min="-1" max="30"/>
      <default>0</default>
      <summary>Order inside panel area (-1 = last)</summary>
    </key>
    <key name="stay-expanded" type="b">
      <default>true</default>
      <summary>Stay expanded while plugged in and fully charged</summary>
    </key>
    <key name="animation-enabled" type="b">
      <default>true</default>
      <summary>Charging animation</summary>
    </key>
    <key name="low-color-enabled" type="b">
      <default>true</default>
      <summary>Red battery on low charge</summary>
    </key>
    <key name="low-threshold" type="i">
      <range min="5" max="50"/>
      <default>15</default>
      <summary>Low battery percent</summary>
    </key>
  </schema>
</schemalist>
