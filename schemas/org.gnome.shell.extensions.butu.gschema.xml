<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.butu" path="/org/gnome/shell/extensions/butu/">
    <key name="color-mode" type="s">
      <choices>
        <choice value="classic"/>
        <choice value="wallpaper"/>
        <choice value="custom"/>
      </choices>
      <default>"classic"</default>
      <summary>Pill background source</summary>
    </key>
    <key name="custom-color" type="s">
      <default>"rgb(53,132,228)"</default>
      <summary>Custom pill background color</summary>
    </key>
    <key name="accent-color" type="s">
      <default>"rgb(88,235,98)"</default>
      <summary>Accent color (percentage, battery, waves)</summary>
    </key>
    <key name="wave-effect" type="s">
      <choices>
        <choice value="sine"/>
        <choice value="cosine"/>
        <choice value="analog"/>
        <choice value="digital"/>
        <choice value="transverse"/>
        <choice value="electromagnetic"/>
        <choice value="seismic"/>
        <choice value="radio"/>
        <choice value="periodic"/>
      </choices>
      <default>"sine"</default>
      <summary>Charging wave effect</summary>
    </key>
    <key name="compact-width" type="i">
      <range min="40" max="160"/>
      <default>84</default>
      <summary>Pill width while not charging</summary>
    </key>
    <key name="expanded-width" type="i">
      <range min="140" max="420"/>
      <default>280</default>
      <summary>Pill width while charging</summary>
    </key>
    <key name="pill-height" type="i">
      <range min="18" max="44"/>
      <default>30</default>
      <summary>Pill height</summary>
    </key>
    <key name="corner-radius" type="i">
      <range min="0" max="30"/>
      <default>15</default>
      <summary>Corner radius</summary>
    </key>
    <key name="font-size" type="i">
      <range min="9" max="20"/>
      <default>12</default>
      <summary>Text size in px</summary>
    </key>
    <key name="position" type="s">
      <choices>
        <choice value="left"/>
        <choice value="center"/>
        <choice value="right"/>
      </choices>
      <default>"center"</default>
      <summary>Panel area</summary>
    </key>
    <key name="position-index" type="i">
      <range min="-1" max="30"/>
      <default>0</default>
      <summary>Order inside panel area (-1 = last)</summary>
    </key>
    <key name="stay-expanded" type="b">
      <default>true</default>
      <summary>Stay expanded while plugged in and fully charged</summary>
    </key>
    <key name="animation-enabled" type="b">
      <default>true</default>
      <summary>Charging animation</summary>
    </key>
    <key name="low-color-enabled" type="b">
      <default>true</default>
      <summary>Red battery on low charge</summary>
    </key>
    <key name="low-threshold" type="i">
      <range min="5" max="50"/>
      <default>15</default>
      <summary>Low battery percent</summary>
    </key>
    <key name="wave-reverse" type="b">
      <default>false</default>
      <summary>Reverse wave direction (default: forward, toward percentage)</summary>
    </key>
    <key name="border-enabled" type="b">
      <default>false</default>
      <summary>Thin dynamic border around the pill</summary>
    </key>
    <key name="border-mode" type="s">
      <choices>
        <choice value="state"/>
        <choice value="level"/>
        <choice value="wallpaper"/>
        <choice value="custom"/>
      </choices>
      <default>"state"</default>
      <summary>Border color source</summary>
    </key>
    <key name="border-color" type="s">
      <default>"rgb(255,255,255)"</default>
      <summary>Custom border color</summary>
    </key>
    <key name="border-width" type="i">
      <range min="1" max="4"/>
      <default>1</default>
      <summary>Border width in px</summary>
    </key>
    <key name="border-opacity" type="i">
      <range min="10" max="100"/>
      <default>70</default>
      <summary>Border opacity in percent</summary>
    </key>
    <key name="battery-style" type="s">
      <choices>
        <choice value="ios"/>
        <choice value="oneui"/>
        <choice value="coloros"/>
        <choice value="emui"/>
        <choice value="classic"/>
        <choice value="circle-cw"/>
        <choice value="circle-ccw"/>
      </choices>
      <default>"ios"</default>
      <summary>Battery icon style</summary>
    </key>
    <key name="battery-size" type="i">
      <range min="10" max="60"/>
      <default>27</default>
      <summary>Battery icon size in px</summary>
    </key>
    <key name="battery-first" type="b">
      <default>false</default>
      <summary>Battery icon before percentage</summary>
    </key>
    <key name="status-offset-x" type="i"><range min="-40" max="40"/><default>0</default><summary>Status text X offset</summary></key>
    <key name="status-offset-y" type="i"><range min="-15" max="15"/><default>0</default><summary>Status text Y offset</summary></key>
    <key name="pct-offset-x" type="i"><range min="-40" max="40"/><default>0</default><summary>Percentage X offset</summary></key>
    <key name="pct-offset-y" type="i"><range min="-15" max="15"/><default>0</default><summary>Percentage Y offset</summary></key>
    <key name="battery-offset-x" type="i"><range min="-40" max="40"/><default>0</default><summary>Battery icon X offset</summary></key>
    <key name="battery-offset-y" type="i"><range min="-15" max="15"/><default>0</default><summary>Battery icon Y offset</summary></key>
    <key name="gap-pct-battery" type="i"><range min="0" max="30"/><default>6</default><summary>Space between percentage and battery icon</summary></key>
    <key name="gap-wave" type="i"><range min="0" max="30"/><default>6</default><summary>Space around the wave</summary></key>
    <key name="padding-x" type="i"><range min="0" max="40"/><default>14</default><summary>Left/right inner padding</summary></key>
  </schema>
</schemalist>
